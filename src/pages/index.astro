---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';

const events = [
  {
    title: "O KOD OMÜ Hackathon",
    category: "Workshop & Yarışma",
    attendees: 50,
    description: "4 kişilik ekiplerin yarıştığı 1 saatlik algoritmik kodlama etkinliği."
  },
  {
    title: "Savunma Sanayii Günleri",
    category: "Söyleşi / Zirve",
    attendees: 300,
    description: "Sektör liderlerinin katılımıyla gerçekleştirilen teknik oturumlar."
  }
];
---

<Layout title="Beyza | Portfolyo">
  <main class="page">
    <section class="hero">
      <p class="eyebrow">Ana Sayfa</p>
      <h1>Beyza'nın Etkinlikleri ve Projeleri</h1>
      <p class="intro">IEEE CS Komite çalışmaları, workshoplar ve projelerle ilgili öne çıkan içerikler.</p>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>Yaklaşan Etkinlikler</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {events.map((event) => (
          <EventCard 
            title={event.title} 
            category={event.category} 
            attendees={event.attendees} 
            description={event.description} 
          />
        ))}
      </div>
    </section>
  </main>

  <style>
    :global(body) {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: linear-gradient(180deg, #f5f7ff 0%, #eef2ff 100%);
      color: #1f2937;
    }

    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px 24px 80px;
    }

    .hero {
      text-align: center;
      padding: 32px 0 36px;
    }

    .eyebrow {
      margin: 0 0 12px;
      font-size: 0.8rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #5b6ef7;
      font-weight: 700;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.2rem, 5vw, 3rem);
      line-height: 1.1;
    }

    .intro {
      max-width: 760px;
      margin: 24px auto 0;
      font-size: 1.08rem;
      line-height: 1.8;
      color: #4b5563;
    }
  </style>
</Layout>
