---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';

const events = [
  {
    title: "Mentorluk Programları",
    category: "Eğitim",
    attendees: 500,
    description: "Bölüm içerisindeki etkileşimi artırmak ve öğrencilerin gelişimine katkıda bulunmak amacıyla gerçekleştirilen mentorluk programları.",
    href: "/mentorluk"
  },
  {
    title: "O-KOD-OMÜ",
    category: "Workshop",
    attendees: 50,
    description: "4 kişilik ekiplerin yarıştığı 1 saatlik mantık kurma ve kodlama yarışması.",
    href: "/Workshop"
  },
  {
    title: "Yüzyüze ve Online Söyleşiler",
    category: "Söyleşi",
    attendees: 200,
    description: "Sektör içinden mühendislerle gerçekleştirilen yüzyüze ve online söyleşiler.",
    href: "/soylesiler"
  },
  {
    title: "Savunma Sanayi Günleri",
    category: "Zirve",
    attendees: 1000,
    description: "Sektör liderlerinin katılımıyla gerçekleştirilen teknik oturumlar! ",
    href: "/savunma-sanayi-gunleri"
  },
  {
    title: "OMÜHENDİS",
    category: "Zirve",
    attendees: 500,
    description: "Sektör liderlerinin katılımıyla gerçekleştirilen sosyal oturumlar! ",
    href: "/omuhendis"
  },
  {
    title: "CS'e Veda Etkinliği",
    category: "Etkinlik",
    attendees: 30,
    description: "İki dönem boyunca CS Komitesi'nde görev almış olan üyeler için düzenlenen veda etkinliği.",
    href: "/veda"
  }
];
---

<Layout title="Beyza | Portfolyo">
  <main class="page">
    <section class="hero">
      <p class="eyebrow">Ana Sayfa</p>
      <h1>CS KOMİTESİ</h1>
      <p class="intro">OMÜ IEEE Computer Society Komitesi 2025-2026 Dönemi</p>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>Gerçekleştirilen Eğitim, Etkinlik ve Söyleşiler</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {events.map((event) => (
          <EventCard
            title={event.title}
            category={event.category}
            attendees={event.attendees}
            description={event.description}
            href={event.href}
          />
        ))}
      </div>
    </section>
  </main>

  <style>
    :global(body) {
      margin: 0;
      font-family: 'Courier New', Courier, 'Roboto Mono', ui-monospace, system-ui;
      background: linear-gradient(180deg, var(--bg-start) 0%, var(--bg-end) 100%);
      color: var(--text);
    }

    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px 24px 80px;
    }

    .hero {
      text-align: center;
      padding: 32px 0 36px;
    }

    .eyebrow {
      margin: 0 0 12px;
      font-size: 0.8rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-1);
      font-weight: 700;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.2rem, 5vw, 3rem);
      line-height: 1.1;
    }

    .intro {
      max-width: 760px;
      margin: 24px auto 0;
      font-size: 1.08rem;
      line-height: 1.8;
      color: var(--muted);
    }
  </style>
</Layout>
