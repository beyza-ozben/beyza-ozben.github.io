---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Beyza | OMÜHENDİS">
  <div class="top-bar">
    <a href="/" class="back-home">← Ana Sayfaya Dön</a>
  </div>

  <main class="page">
    <section class="hero">
      <p class="eyebrow">Zirve</p>
      <h1>OMÜHENDİS</h1>
    </section>

    <section class="section">
      <div class="content-card">
        <p>
          OMÜHENDİS etkinliği, mühendislik alanında birbirinden değerli paydaşların bir araya
          geldiği, bilgi, deneyim ve motivasyon paylaşımının yapıldığı bir platform oldu.
        </p>
        <p>
          Etkinlik boyunca saha deneyimleri, kariyer yol haritaları ve teknoloji odaklı konuşmalar
          düzenlenerek katılımcılara güçlü bir öğrenme ortamı sunuldu.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .top-bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 24px 0;
  }

  .back-home {
    display: inline-block;
    color: var(--accent-1);
    font-weight: 700;
  }

  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px 80px;
  }

  .hero {
    text-align: center;
    padding: 20px 0 24px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-1);
    font-weight: 700;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .section {
    margin-top: 32px;
  }

  .content-card {
    background: var(--card-bg);
    border: 4px solid var(--border-strong);
    padding: 28px;
    line-height: 1.8;
    color: var(--muted);
  }
</style>
