---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Beyza | Söyleşiler">
  <main class="page">

    <section class="hero">
      <p class="eyebrow">Söyleşi</p>
      <h1>Yüzyüze ve Online Söyleşiler</h1>
      <div class="intro intro-block">
        <p>
          Sektör içinden mühendislik profesyonelleriyle gerçekleştirilen söyleşiler, katılımcılara
          kariyer, teknoloji ve mesleki gelişim üzerine değerli içerikler sundu.
        </p>
        <p>
          Hem yüz yüze hem de online formatlarla düzenlenen bu etkinlikler, farklı mekân ve zaman
          koşullarında da erişilebilir, samimi ve öğretici bir öğrenme deneyimi sağladı.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .top-bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 24px 0;
  }

  .back-home {
    display: inline-block;
    color: var(--accent-1);
    font-weight: 700;
  }

  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px 80px;
  }

  .hero {
    text-align: center;
    padding: 20px 0 24px;
  }

  .intro {
    max-width: 760px;
    margin: 24px auto 0;
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .intro-block {
    text-align: justify;
    max-width: 900px;
    padding: 28px 24px;
    background: rgba(255, 255, 255, 0.4);
    border: 4px solid var(--border-strong);
    box-shadow: 8px 8px 0 rgba(17, 17, 17, 0.12);
  }

  .intro-block p,
  .intro-block li {
    font-weight: 700;
    line-height: 1.9;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-1);
    font-weight: 700;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .section {
    margin-top: 32px;
  }

  .content-card {
    background: var(--card-bg);
    border: 4px solid var(--border-strong);
    padding: 28px;
    line-height: 1.8;
    color: var(--muted);
  }
</style>
