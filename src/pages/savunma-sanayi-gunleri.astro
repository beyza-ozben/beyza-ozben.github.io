---
import Layout from '../layouts/Layout.astro';

const photos = [
  { src: 'SSG-brosur1.jpg', alt: 'Broşür ön yüz' },
  { src: 'SSG-brosur2.jpg', alt: 'Broşür arka yüz' },
  { src: 'SSG-ekip.jpg', alt: 'CS Komite Ekibi' },
  { src: 'SSG-nesnetakibi.jpg', alt: 'CS Komite Stant Sergisi' },
  { src: 'SSG-MehmetBey.JPG', alt: 'ASPİSAL, Mehmet Öztürk' },
  { src: 'SSG-tugcehanim.jpg', alt: 'ASELSAN, Tuğçe Yağcıoğlu' },
  { src: 'SSG-BTK.JPG', alt: 'BTK, Abdurrahman Er & Recep Gülçiçek' },
  { src: 'SSG-Ahmetbey.jpg', alt: 'TUSAŞ, Ahmet Ethem Danış' },
  { src: 'SSGtoplu.JPG', alt: 'Oturumdan fotoğraflar' },
  { src: 'SSGtoplu2.jpg', alt: 'Oturumdan fotoğraflar' },
  { src: 'SSG-soru.JPG', alt: 'Oturumdan fotoğraflar' },
  { src: 'SSG-toplu3.jpg', alt: 'Oturumdan fotoğraflar' }
];


function resolvePath(p = '') {
  if (!p) return '';
  if (p.startsWith('/public/')) return p.replace(/^\/public\//, '/');
  if (p.startsWith('/')) return p;
  return `/${p}`;
}

// Optional hero image at the top of the page. Set to empty string if unused.
const heroImage = 'SSG-afis.jpg';
const heroAlt = 'Savunma Sanayi Günleri';
---

<Layout title="Beyza | Savunma Sanayi Günleri">
  <main class="page">
    <section class="hero">
      <p class="eyebrow">Zirve</p>
      <h1>Savunma Sanayi Günleri</h1>
      {heroImage ? (
        <div class="hero-image">
          <img src={resolvePath(heroImage)} alt={heroAlt} />
        </div>
      ) : null}
      <div class="intro intro-block">
        <p>
          Milli Teknolojinin Kalbi OMÜ’de Atıyor: 8. Savunma Sanayi Günleri 8-9 Aralık 2025'te gerçekleşti! </p>

        <p>
          IEEE Ondokuz Mayıs Üniversitesi Öğrenci Kolu tarafından 2025 yılında sekizincisi düzenlenen Savunma Sanayi Günleri (SSG), Türkiye’nin yerli ve milli teknoloji hamlesine yön veren öncü kurumları, alanında uzman mühendisleri ve geleceği inşa edecek genç mühendis adaylarını bir araya getirdi. Ülkemizin savunma, havacılık, uzay ve bilişim ekosistemini yakından tanıma fırsatı sunan SSG'26; ilham verici oturumları, sektör liderlerinin kariyer tecrübeleri ve inovatif vizyonlarıyla dolu dolu bir program gerçekleştirildi.
        </p>

        <p>
          Katılımcılar, alanında uzman konuşmacılardan teknik ve stratejik bakış açıları
          edindiler; beraberinde iş birlikleri ve yeni fırsatlara dair önemli fikir alışverişleri
          yaptılar.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>Etkinlikten Kareler</h2>
      </div>

      <div class="gallery">
        {photos.map((photo) => (
          <figure class="card">
            <img class="enlargeable" src={resolvePath(photo.src)} alt={photo.alt} />
            <figcaption class="caption">{photo.alt}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>

  <div id="image-modal" class="image-modal hidden" aria-hidden="true">
    <div class="modal-backdrop" id="modal-backdrop"></div>
    <div class="modal-content" role="dialog" aria-modal="true">
      <button id="modal-close" class="modal-close" aria-label="Kapat">×</button>
      <img id="modal-img" src="" alt="" />
      <p id="modal-caption" class="modal-caption"></p>
    </div>
  </div>

  <script>
    (function () {
      const modal = document.getElementById('image-modal');
      const modalImg = document.getElementById('modal-img');
      const modalCaption = document.getElementById('modal-caption');
      const modalClose = document.getElementById('modal-close');
      const backdrop = document.getElementById('modal-backdrop');

      function openModal(src: string, alt: string) {
        if (!modal || !(modalImg instanceof HTMLImageElement)) return;
        modalImg.src = src || '';
        modalImg.alt = alt || '';
        if (modalCaption) modalCaption.textContent = alt || '';
        modal.classList.remove('hidden');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.add('hidden');
        modal.setAttribute('aria-hidden', 'true');
        if (modalImg instanceof HTMLImageElement) {
          modalImg.src = '';
          modalImg.alt = '';
        }
        if (modalCaption) modalCaption.textContent = '';
        document.body.style.overflow = '';
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const img = target.closest('.enlargeable');
        if (img instanceof HTMLImageElement) {
          openModal(img.getAttribute('src') || '', img.getAttribute('alt') || '');
        }
      });

      if (modalClose) modalClose.addEventListener('click', closeModal);
      if (backdrop) backdrop.addEventListener('click', closeModal);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeModal();
      });
    })();
  </script>
</Layout>

<style>
  .top-bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 24px 0;
  }

  .back-home {
    display: inline-block;
    color: var(--accent-1);
    font-weight: 700;
  }

  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 24px 80px;
  }

  .hero {
    text-align: center;
    padding: 20px 0 24px;
  }

  .intro {
    max-width: 760px;
    margin: 24px auto 0;
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .intro-block {
    text-align: justify;
    max-width: 900px;
    padding: 28px 24px;
    background: rgba(255, 255, 255, 0.4);
    border: 4px solid var(--border-strong);
    box-shadow: 8px 8px 0 rgba(17, 17, 17, 0.12);
  }

  .intro-block p,
  .intro-block li {
    font-weight: 700;
    line-height: 1.9;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    max-height: 90vh;
  }

  @media (max-width: 760px) {
    .hero-image img {
      max-height: 60vh;
    }
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-1);
    font-weight: 700;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .section {
    margin-top: 32px;
  }

  .content-card {
    background: var(--card-bg);
    border: 4px solid var(--border-strong);
    padding: 28px;
    line-height: 1.8;
    color: var(--muted);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .card {
    margin: 0;
    overflow: hidden;
    border: 4px solid var(--border-strong);
    background: var(--card-bg);
    box-shadow: 8px 8px 0 rgba(17, 17, 17, 0.12);
  }

  .card img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    background: #f3efe8;
  }

  .card .caption {
    margin: 0;
    padding: 12px 14px;
    font-size: 1rem;
    line-height: 1.4;
    text-align: center;
    color: var(--muted);
    font-weight: 700;
  }

  .image-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .image-modal:not(.hidden) {
    pointer-events: auto;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
  }

  .modal-content {
    position: relative;
    z-index: 1;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .modal-content img {
    max-width: 100%;
    max-height: 80vh;
    border: 4px solid var(--border-strong);
    background: var(--card-bg);
  }

  .modal-close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background: #fff;
    font-size: 22px;
    font-weight: 700;
    cursor: pointer;
  }

  .modal-caption {
    margin: 0;
    color: #fff;
    text-align: center;
    font-size: 1.15rem;
    line-height: 1.4;
    font-weight: 700;
  }

  .hidden {
    display: none !important;
  }
</style>
