---
interface Props {
  title: string;
  category: string;
  attendees: number;
  description: string;
  href: string;
}

const { title, category, attendees, description, href } = Astro.props;
---

<a href={href} class="event-card-link">
  <div class="event-card">
    <div class="event-meta">
      <span class="event-category">{category}</span>
      <span class="event-attendees">👥 {attendees}+ Katılımcı</span>
    </div>
    <h3 class="event-title">{title}</h3>
    <p class="event-desc">{description}</p>
  </div>
</a>

<style>
  .event-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .event-card {
    background: var(--card-bg);
    padding: 20px;
    border-radius: 4px;
    border: 4px solid var(--border-strong);
    transition: transform 0.12s ease;
    height: 100%;
  }

  .event-card:hover { transform: translateY(-4px); }
  .event-meta { display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; }
  .event-category { font-size:12px; font-weight:700; padding:6px 10px; border-radius:2px; background: var(--accent-1); color: #fff; }
  .event-attendees { color: var(--muted); font-size:12px }
  .event-title { margin:0 0 8px; font-size:18px; color:var(--text) }
  .event-desc { margin:0; color: var(--muted); font-size:14px }
</style>
