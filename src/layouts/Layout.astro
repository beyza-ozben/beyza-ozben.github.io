---
import Nav from '../components/Nav.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/public/BeyzaPortfolio.ico" />
		<link rel="icon" href="/public/BeyzaPortfolio.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>CS KOMİTESİ</title>
	</head>
	<body>
		<Nav />
		<slot />
	</body>
</html>

<style>
	:root{
		/* Brutalist / Retro-block palette */
		--accent-1: #d65a2a; /* burnt orange */
		--accent-2: #3e6b2f; /* olive green */
		--muted: #2b2b2b;
		--bg-start: #f6f3ee;
		--bg-end: #e9e3d6;
		--card-bg: #fffefb;
		--border-strong: #1f1f1f;
		--text: #111111;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, var(--bg-start) 0%, var(--bg-end) 100%);
		color: var(--text);
		font-family: 'Courier New', Courier, 'Roboto Mono', ui-monospace, system-ui;
	}

	a { color: var(--accent-1); text-decoration: none; }

	/* Global image hover zoom: tüm sayfalardaki ana içerik görsellerine uygulanır */
	:global(main img), :global(.page img) {
		transition: transform 160ms ease, filter 160ms ease;
		will-change: transform;
		max-width: 100%;
		height: auto;
		display: block;
	}

	:global(main img:hover), :global(.page img:hover) {
		transform: scale(1.06);
	}

	/* Daha doğal bir etki için resimleri kapsayan konteynırlara overflow gizlemesi
	   uygularsanız kenar taşmalarını engellersiniz. Bunu kullanmak isterseniz
	   ilgili elementlere `overflow: hidden` ekleyin. */
</style>
